{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "incremental": true,
    "outDir": "dist",
    "rootDir": "../..",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "../../packages/shared/src"]
}
