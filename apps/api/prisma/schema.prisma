generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OperationStatus {
  DRAFT
  PLAN_GENERATED
  APPROVED
  CANCELLED
}

enum LoadingMethod {
  REAR
  SIDE
  TOP
  MIXED
}

enum TruckZoneType {
  CABIN_SIDE
  CENTER
  DOOR_SIDE
}

enum ProductFamily {
  COIL
  SHEET
  PROFILE
  TUBE
  BAR
  GENERIC_PACKAGE
}

enum PlanStatus {
  GENERATED
  MODIFIED
  APPROVED
  INVALID
}

enum UnplacedReason {
  DOES_NOT_FIT
  EXCEEDS_WEIGHT
  NO_AVAILABLE_SPACE
  STACKING_RESTRICTION
  MANUAL_REVIEW_REQUIRED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertType {
  MAX_WEIGHT_EXCEEDED
  OUT_OF_BOUNDS
  OVERLAP
  HEIGHT_EXCEEDED
  UNPLACED_ITEM
  WEIGHT_IMBALANCE
  DESTINATION_BLOCKED
  STACKING_RISK
  MANUAL_REVIEW_REQUIRED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  DRAFT
  RECEIVED
  CREDIT_HELD
  RELEASED
  CANCELLED
}

enum CreditStatus {
  PENDING
  HELD
  RELEASED
}

enum SellerPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DeliveryPlanStatus {
  DRAFT
  PLANNED
  CANCELLED
}

enum DispatchOrderStatus {
  PLANNED
  READY_TO_LOAD
  LOAD_OPERATION_LINKED
  CANCELLED
}

model Customer {
  id        String         @id @default(uuid())
  code      String         @unique
  name      String
  taxId     String?
  status    CustomerStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  orders Order[]

  @@index([name])
  @@index([status])
}

model Order {
  id                  String         @id @default(uuid())
  code                String         @unique
  customerId          String
  status              OrderStatus    @default(RECEIVED)
  creditStatus        CreditStatus   @default(PENDING)
  sellerPriority      SellerPriority @default(NORMAL)
  destinationCatalogId String?
  destinationName     String?
  requestedDeliveryAt DateTime?
  externalRef         String?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  dispatchOrders DispatchOrder[]

  @@index([customerId])
  @@index([status, creditStatus])
  @@index([sellerPriority])
  @@index([requestedDeliveryAt])
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  productCatalogId String?
  productCode      String
  description      String?
  quantity         Int      @default(1)
  weightKg         Decimal? @db.Decimal(12, 3)
  lengthMm         Int?
  widthMm          Int?
  heightMm         Int?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productCatalog ProductCatalog? @relation(fields: [productCatalogId], references: [id], onDelete: SetNull)
  dispatchItems DispatchOrderItem[]

  @@index([orderId])
  @@index([productCatalogId])
  @@index([productCode])
}

model LoadOperation {
  id          String          @id @default(uuid())
  code        String          @unique
  status      OperationStatus @default(DRAFT)
  name        String?
  notes       String?
  scheduledAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  truck                  Truck?
  destinations           Destination[]
  products               LoadProduct[]
  vehicleAssignment      OperationVehicleAssignment?
  destinationAssignments OperationDestinationAssignment[]
  productAssignments     OperationProductAssignment[]
  plans                  LoadingPlan[]
  dispatchOrder          DispatchOrder?

  @@index([status])
  @@index([scheduledAt])
}

model ProductCatalog {
  id              String        @id @default(uuid())
  code            String        @unique
  family          ProductFamily
  description     String?
  weightKg        Decimal?      @db.Decimal(12, 3)
  lengthMm        Int?
  widthMm         Int?
  heightMm        Int?
  stackable       Boolean       @default(false)
  rotationAllowed Boolean       @default(true)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  operationAssignments OperationProductAssignment[]
  orderItems           OrderItem[]
  dispatchItems        DispatchOrderItem[]

  @@index([family])
  @@index([description])
  @@index([isActive])
}

model DestinationCatalog {
  id        String   @id @default(uuid())
  code      String?  @unique
  name      String
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operationAssignments OperationDestinationAssignment[]
  dispatchOrders       DispatchOrder[]

  @@index([name])
  @@index([isActive])
}

model DeliveryPlan {
  id          String             @id @default(uuid())
  code        String             @unique
  status      DeliveryPlanStatus @default(DRAFT)
  plannedDate DateTime?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  dispatchOrders DispatchOrder[]

  @@index([status])
  @@index([plannedDate])
}

model DispatchOrder {
  id                      String              @id @default(uuid())
  code                    String              @unique
  status                  DispatchOrderStatus @default(PLANNED)
  orderId                 String
  deliveryPlanId          String?
  destinationCatalogId    String?
  destinationNameSnapshot String?
  sellerPriority          SellerPriority
  requestedDeliveryAt     DateTime?
  loadOperationId         String?             @unique
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  deliveryPlan       DeliveryPlan?       @relation(fields: [deliveryPlanId], references: [id], onDelete: SetNull)
  destinationCatalog DestinationCatalog? @relation(fields: [destinationCatalogId], references: [id], onDelete: SetNull)
  loadOperation      LoadOperation?      @relation(fields: [loadOperationId], references: [id], onDelete: SetNull)
  items              DispatchOrderItem[]

  @@index([status])
  @@index([orderId])
  @@index([deliveryPlanId])
  @@index([destinationCatalogId])
  @@index([requestedDeliveryAt])
}

model DispatchOrderItem {
  id                  String   @id @default(uuid())
  dispatchOrderId     String
  orderItemId         String
  productCatalogId    String
  productCodeSnapshot String
  descriptionSnapshot String?
  quantity            Int      @default(1)
  weightKg            Decimal? @db.Decimal(12, 3)
  lengthMm            Int?
  widthMm             Int?
  heightMm            Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  dispatchOrder DispatchOrder  @relation(fields: [dispatchOrderId], references: [id], onDelete: Cascade)
  orderItem     OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productCatalog ProductCatalog @relation(fields: [productCatalogId], references: [id], onDelete: Restrict)

  @@unique([dispatchOrderId, orderItemId])
  @@index([orderItemId])
  @@index([productCatalogId])
}

model TruckCatalog {
  id            String        @id @default(uuid())
  plate         String        @unique
  description   String?
  loadingMethod LoadingMethod @default(REAR)
  maxPayloadKg  Decimal?      @db.Decimal(12, 3)
  lengthMm      Int?
  widthMm       Int?
  heightMm      Int?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  zoneTemplates        ZoneTemplate[]
  operationAssignments OperationVehicleAssignment[]

  @@index([plate])
  @@index([isActive])
}

model TrailerCatalog {
  id           String   @id @default(uuid())
  code         String   @unique
  description  String?
  maxPayloadKg Decimal? @db.Decimal(12, 3)
  lengthMm     Int?
  widthMm      Int?
  heightMm     Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  operationAssignments OperationVehicleAssignment[]

  @@index([isActive])
}

model ZoneTemplate {
  id             String        @id @default(uuid())
  truckCatalogId String
  type           TruckZoneType
  name           String?
  maxWeightKg    Decimal?      @db.Decimal(12, 3)
  startXMm       Int?
  endXMm         Int?
  startYMm       Int?
  endYMm         Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  truckCatalog   TruckCatalog         @relation(fields: [truckCatalogId], references: [id], onDelete: Cascade)
  operationZones OperationTruckZone[]

  @@unique([truckCatalogId, type])
  @@index([truckCatalogId])
}

model OperationDestinationAssignment {
  id                 String   @id @default(uuid())
  operationId        String
  destinationCatalogId String
  unloadingOrder     Int
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  operation LoadOperation      @relation(fields: [operationId], references: [id], onDelete: Cascade)
  catalog   DestinationCatalog @relation(fields: [destinationCatalogId], references: [id], onDelete: Restrict)
  products  OperationProductAssignment[]

  @@unique([operationId, unloadingOrder])
  @@unique([operationId, destinationCatalogId])
  @@index([destinationCatalogId])
}

model OperationProductAssignment {
  id                         String        @id @default(uuid())
  operationId                String
  productCatalogId           String
  operationDestinationId     String?
  quantity                   Int           @default(1)
  weightKgOverride           Decimal?      @db.Decimal(12, 3)
  lengthMmOverride           Int?
  widthMmOverride            Int?
  heightMmOverride           Int?
  stackableOverride          Boolean?
  rotationAllowedOverride    Boolean?
  notes                      String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  operation            LoadOperation                   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  catalog              ProductCatalog                  @relation(fields: [productCatalogId], references: [id], onDelete: Restrict)
  operationDestination OperationDestinationAssignment? @relation(fields: [operationDestinationId], references: [id], onDelete: SetNull)
  @@index([operationId, operationDestinationId])
  @@index([operationId, productCatalogId])
  @@index([productCatalogId])
}

model OperationVehicleAssignment {
  id               String   @id @default(uuid())
  operationId      String   @unique
  truckCatalogId   String
  trailerCatalogId String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  operation LoadOperation   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  truck     TruckCatalog    @relation(fields: [truckCatalogId], references: [id], onDelete: Restrict)
  trailer   TrailerCatalog? @relation(fields: [trailerCatalogId], references: [id], onDelete: SetNull)
  zones     OperationTruckZone[]

  @@index([truckCatalogId])
  @@index([trailerCatalogId])
}

model OperationTruckZone {
  id                  String        @id @default(uuid())
  vehicleAssignmentId String
  zoneTemplateId      String?
  type                TruckZoneType
  name                String?
  maxWeightKg         Decimal?      @db.Decimal(12, 3)
  startXMm            Int?
  endXMm              Int?
  startYMm            Int?
  endYMm              Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  vehicleAssignment OperationVehicleAssignment @relation(fields: [vehicleAssignmentId], references: [id], onDelete: Cascade)
  zoneTemplate      ZoneTemplate?              @relation(fields: [zoneTemplateId], references: [id], onDelete: SetNull)
  @@unique([vehicleAssignmentId, type])
  @@index([vehicleAssignmentId])
  @@index([zoneTemplateId])
}

model Truck {
  id            String        @id @default(uuid())
  operationId   String        @unique
  plate         String
  description   String?
  loadingMethod LoadingMethod @default(REAR)
  maxPayloadKg  Decimal?      @db.Decimal(12, 3)
  lengthMm      Int?
  widthMm       Int?
  heightMm      Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  operation LoadOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  zones     TruckZone[]

  @@index([plate])
}

model TruckZone {
  id          String        @id @default(uuid())
  truckId     String
  type        TruckZoneType
  name        String?
  maxWeightKg Decimal?      @db.Decimal(12, 3)
  startXMm    Int?
  endXMm      Int?
  startYMm    Int?
  endYMm      Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  truck       Truck        @relation(fields: [truckId], references: [id], onDelete: Cascade)
  placedItems PlacedItem[]

  @@unique([truckId, type])
  @@index([truckId])
}

model Destination {
  id             String   @id @default(uuid())
  operationId    String
  code           String?
  name           String
  unloadingOrder Int
  address        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  operation LoadOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  products  LoadProduct[]

  @@unique([operationId, unloadingOrder])
  @@index([operationId, code])
}

model LoadProduct {
  id              String        @id @default(uuid())
  operationId     String
  destinationId   String?
  code            String
  family          ProductFamily
  description     String?
  quantity        Int           @default(1)
  weightKg        Decimal?      @db.Decimal(12, 3)
  lengthMm        Int?
  widthMm         Int?
  heightMm        Int?
  stackable       Boolean       @default(false)
  rotationAllowed Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  operation   LoadOperation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  destination Destination?   @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  placedItems PlacedItem[]
  unplacedIn  UnplacedItem[]
  alerts      LoadAlert[]

  @@index([operationId, destinationId])
  @@index([operationId, code])
  @@index([family])
}

model LoadingPlan {
  id          String        @id @default(uuid())
  operationId String
  version     Int
  status      PlanStatus    @default(GENERATED)
  method      LoadingMethod
  isCurrent   Boolean       @default(false)
  notes       String?
  approvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  operation   LoadOperation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  placedItems PlacedItem[]
  unplaced    UnplacedItem[]
  steps       LoadingStep[]
  alerts      LoadAlert[]
  metrics     PlanMetrics?

  @@unique([operationId, version])
  @@index([operationId, isCurrent, version])
  @@index([operationId, status])
}

model PlacedItem {
  id          String   @id @default(uuid())
  planId      String
  productId   String
  unitIndex   Int      @default(1)
  truckZoneId String?
  xMm         Int
  yMm         Int
  zMm         Int      @default(0)
  rotationDeg Int      @default(0)
  lengthMm    Int?
  widthMm     Int?
  heightMm    Int?
  locked      Boolean  @default(false)
  manuallyAdjusted Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan      LoadingPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  product   LoadProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)
  truckZone TruckZone?    @relation(fields: [truckZoneId], references: [id], onDelete: SetNull)
  steps     LoadingStep[]
  alerts    LoadAlert[]

  @@unique([planId, productId, unitIndex])
  @@index([planId])
  @@index([productId])
  @@index([truckZoneId])
}

model UnplacedItem {
  id        String         @id @default(uuid())
  planId    String
  productId String
  unitIndex Int            @default(1)
  reason    UnplacedReason
  message   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  plan    LoadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  product LoadProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([planId, productId, unitIndex])
  @@index([planId])
  @@index([productId])
}

model LoadingStep {
  id           String   @id @default(uuid())
  planId       String
  placedItemId String?
  sequence     Int
  title        String
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plan       LoadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  placedItem PlacedItem? @relation(fields: [placedItemId], references: [id], onDelete: SetNull)

  @@unique([planId, sequence])
  @@index([planId])
  @@index([placedItemId])
}

model LoadAlert {
  id           String        @id @default(uuid())
  planId       String
  productId    String?
  placedItemId String?
  severity     AlertSeverity
  type         AlertType
  message      String
  createdAt    DateTime      @default(now())

  plan       LoadingPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  product    LoadProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  placedItem PlacedItem?  @relation(fields: [placedItemId], references: [id], onDelete: SetNull)

  @@index([planId, severity])
  @@index([planId, type])
  @@index([productId])
  @@index([placedItemId])
}

model PlanMetrics {
  id               String   @id @default(uuid())
  planId           String   @unique
  totalWeightKg    Decimal? @db.Decimal(12, 3)
  placedWeightKg   Decimal? @db.Decimal(12, 3)
  unplacedWeightKg Decimal? @db.Decimal(12, 3)
  usedVolumeM3     Decimal? @db.Decimal(12, 3)
  volumeUtilizationPct Decimal? @db.Decimal(7, 3)
  placedItemCount  Int?
  unplacedItemCount Int?
  leftWeightKg     Decimal? @db.Decimal(12, 3)
  rightWeightKg    Decimal? @db.Decimal(12, 3)
  cabinSideWeightKg Decimal? @db.Decimal(12, 3)
  centerWeightKg   Decimal? @db.Decimal(12, 3)
  doorSideWeightKg Decimal? @db.Decimal(12, 3)
  criticalAlertCount Int?
  warningAlertCount Int?
  loadLengthMm     Int?
  maxHeightMm      Int?
  centerOfGravityX Decimal? @db.Decimal(12, 3)
  centerOfGravityY Decimal? @db.Decimal(12, 3)
  centerOfGravityZ Decimal? @db.Decimal(12, 3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  plan LoadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}
